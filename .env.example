# 必填
BOT_TOKEN=your_telegram_bot_token_here

# 时区（用于日志和定时任务）
TZ=Asia/Shanghai

# 数据存储路径（Docker 容器内路径，通常不需要改）
DB_PATH=/data/app.db
DOWNLOAD_DIR=/data/downloads

# 每日定时检查时间（24 小时制）
CHECK_HOUR=9
CHECK_MINUTE=0

# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 第一个私聊 bot 的用户自动成为 owner
AUTO_INIT_OWNER=true

# APK 筛选条件（在 variant 行文本中匹配）
REQUIRE_SIGNATURE=3891
REQUIRE_VARIANT=bd32

# 优先选择 APK，跳过 BUNDLE
PREFER_APK=true

# HTTP 请求超时（秒）
REQUEST_TIMEOUT=60

# ---------- APK 文件清理 ----------
# 推送成功后立即删除 APK 文件
DELETE_AFTER_PUSH=false
# 保留最近 N 个 APK 文件（0 = 不限制）
MAX_KEEP_FILES=5
