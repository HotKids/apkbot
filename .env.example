# Bot runtime only; offline tests and source probes need no credentials.
BOT_TOKEN=
OWNER_ID=
# Required: public HTTPS origin pointing to the download redirect service.
# Example: https://dl.example.com (no trailing path/query).
PUBLIC_DOWNLOAD_BASE_URL=
# Direct Python runs listen on loopback; Compose sets its container bind.
DOWNLOAD_BIND_HOST=127.0.0.1
DOWNLOAD_BIND_PORT=8080
TZ=Asia/Shanghai
CHECK_INTERVAL=1440
DB_PATH=/data/app.db
LOG_LEVEL=INFO
REQUEST_TIMEOUT=60
# Optional existing local Bot API; link delivery needs no local file API.
# Start it only if desired: docker compose --profile local-api up -d --build
# Set LOCAL_BOT_API_URL=http://telegram-bot-api:8081 and fill these securely.
LOCAL_BOT_API_URL=
API_ID=
API_HASH=
