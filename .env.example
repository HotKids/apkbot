# ===== 必填 =====
BOT_TOKEN=123456:ABCDEF
OWNER_ID=123456789
TARGET_CHAT_ID=-1001234567890
CRON_SCHEDULE=0 9 * * *

# 监控地址通过私信 bot 发送 /sub <url> 配置，无需在此填写

# ===== 可选：基础 =====
TZ=Asia/Shanghai
DB_PATH=/data/app.db
DOWNLOAD_DIR=/data/downloads
LOG_LEVEL=INFO
REQUEST_TIMEOUT=60

# ===== 可选：APK 类型 =====
PREFER_APK=true
ALLOW_BUNDLE=false

# ===== 可选：Variant 过滤（逗号分隔） =====
# 必须同时包含所有指定签名（AND）
REQUIRED_SIGNATURES=3891,bd32
# 至少命中一个架构（OR）
REQUIRED_ARCHITECTURES=arm64-v8a,armeabi-v7a
# 指定 DPI（留空则不过滤）
REQUIRED_DPI=nodpi
# 指定设备类型（留空则不过滤）
REQUIRED_DEVICE_TYPE=universal

# ===== 可选：Android 版本范围（API 等级整数，留空则不过滤） =====
MIN_ANDROID_FLOOR=
MIN_ANDROID_CEILING=

# ===== 可选：关键词过滤（逗号分隔，留空则不过滤） =====
MATCH_KEYWORDS=
EXCLUDE_KEYWORDS=

# ===== 可选：文件清理 =====
DELETE_AFTER_PUSH=false
MAX_KEEP_FILES=5
