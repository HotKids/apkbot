# ===== 必填 =====
BOT_TOKEN=123456:ABCDEF
OWNER_ID=123456789

# ===== 可选：基础 =====
TZ=Asia/Shanghai
CHECK_INTERVAL=60          # 轮询间隔（分钟），默认 60
DB_PATH=/data/app.db
DOWNLOAD_DIR=/data/downloads
LOG_LEVEL=INFO
REQUEST_TIMEOUT=60

# ===== 可选：Variant 筛选（由 selector 模块处理，留空使用默认值） =====
PREFER_APK=true
ALLOW_BUNDLE=false
PREFER_UNIVERSAL=true
PREFER_LOWER_ANDROID=true
PREFER_MULTI_SIGNATURE=true

# 必须同时包含所有指定签名（AND）。示例：3891,bd32
REQUIRED_SIGNATURES=
# 至少命中一个架构（OR）。示例：arm64-v8a,armeabi-v7a
REQUIRED_ARCHITECTURES=
# 指定 DPI。示例：nodpi
REQUIRED_DPI=
# 指定设备类型。示例：universal
REQUIRED_DEVICE_TYPE=

# ===== 可选：Android 版本范围（API 等级整数，留空则不过滤） =====
MIN_ANDROID_FLOOR=
MIN_ANDROID_CEILING=

# ===== 可选：关键词过滤（逗号分隔，留空则不过滤） =====
MATCH_KEYWORDS=
EXCLUDE_KEYWORDS=

# ===== 可选：文件清理 =====
DELETE_AFTER_PUSH=false
MAX_KEEP_FILES=5
