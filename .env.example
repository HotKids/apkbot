# ===== 必填 =====
BOT_TOKEN=123456:ABCDEF
OWNER_ID=123456789

# ===== 可选 =====
TZ=Asia/Shanghai
CHECK_INTERVAL=60          # 轮询间隔（分钟），默认 60
DB_PATH=/data/app.db
DOWNLOAD_DIR=/data/downloads
LOG_LEVEL=INFO
REQUEST_TIMEOUT=60

# ===== 本地 Bot API 服务器（突破 50 MB 上传限制）=====
API_ID=12345678            # 从 my.telegram.org 获取
API_HASH=abcdef1234567890  # 从 my.telegram.org 获取
LOCAL_BOT_API_URL=http://telegram-bot-api:8081
